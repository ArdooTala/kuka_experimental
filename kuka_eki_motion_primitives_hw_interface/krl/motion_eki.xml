<ETHERNETKRL>
   <CONFIGURATION>
      <EXTERNAL>
         <TYPE>Client</TYPE>                       <!-- Users connect as clients -->
      </EXTERNAL>
      <INTERNAL>
         <ENVIRONMENT>Program</ENVIRONMENT>        <!-- Server run via robot interpreter (Program / Submit / System) -->
         <BUFFSIZE limit="65534" />
         <BUFFERING Mode="FIFO" Limit="128" />     <!-- Mode: FIFO /LIFO | Limit: Buffering up to *limit* messages (system max) -->
         <ALIVE Set_Flag="1" />                    <!-- Use $flag[1] to indicate alive/good connection status -->
         <IP>0.0.0.0</IP>                          <!-- IP address for EKI interface on robot controller (KRC) -->
         <PORT>54600</PORT>                        <!-- Port of EKI interface on robot controller [54600, 54615] -->
         <PROTOCOL>TCP</PROTOCOL>                  <!-- Use TCP / UDP protocol -->
      </INTERNAL>
   </CONFIGURATION>
   
   <RECEIVE>
      <XML>
         <!-- Command -->
         <ELEMENT Tag="RobotCommand/@Id" Type="INT"/>
         <ELEMENT Tag="RobotCommand/@Type" Type="INT"/> <!-- Type: 1=Move, 2=Gripper, 4=Abort -->
         <ELEMENT Tag="RobotCommand/AbortCommands" Set_Flag="3"/>
         <ELEMENT Tag="RobotCommand/ResetAbortCommands" Set_Flag="4"/>
         <!-- Move parameter -->
         <ELEMENT Tag="RobotCommand/Move/@Mode" Type="INT"/> <!-- Mode: 1=Joint, 2=Cartesian-Ptp, 3=Cartesian-Lin, 6=Cartesian-Circ (4=Teached-Ptp, 5=Teached-Lin) -->
         <ELEMENT Tag="RobotCommand/Move/@BaseIndex" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Move/@ToolIndex" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Move/@Velocity" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/@Acceleration" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/@Blending" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/@WaitForGripper" Type="INT"/>
         <!-- Move joint positions -->
         <ELEMENT Tag="RobotCommand/Move/Joint/@A1" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Joint/@A2" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Joint/@A3" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Joint/@A4" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Joint/@A5" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Joint/@A6" Type="REAL"/>
         <!-- Move cartesian positions -->
         <ELEMENT Tag="RobotCommand/Move/Cartesian/@X" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian/@Y" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian/@Z" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian/@A" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian/@B" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian/@C" Type="REAL"/>
         <!-- Cartesian_aux for circ command -->
         <ELEMENT Tag="RobotCommand/Move/Cartesian_Aux/@X" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian_Aux/@Y" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian_Aux/@Z" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian_Aux/@A" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian_Aux/@B" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/Cartesian_Aux/@C" Type="REAL"/>
         <!-- Move external axes positions -->
         <ELEMENT Tag="RobotCommand/Move/ExtAxis/@E1" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/ExtAxis/@E2" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/ExtAxis/@E3" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/ExtAxis/@E4" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/ExtAxis/@E5" Type="REAL"/>
         <ELEMENT Tag="RobotCommand/Move/ExtAxis/@E6" Type="REAL"/>
         <!-- Move teached position index -->
         <ELEMENT Tag="RobotCommand/Move/Teached/@PositionIndex" Type="INT"/>
         <!-- Gripper parameter -->
         <ELEMENT Tag="RobotCommand/Grip/@Mode" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Grip/Jaw/@Tolerance" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Grip/Jaw/@Velocity" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Grip/Jaw/@Force" Type="INT"/>
         <!-- Grip positions -->
         <ELEMENT Tag="RobotCommand/Grip/Jaw/@BasePosition" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Grip/Jaw/@WorkPosition" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Grip/Jaw/@TeachPosition" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Grip/Jaw/@ShiftPosition" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Grip/Jaw/@DirectionMode" Type="INT"/>
         <!-- Grip vacuum -->
         <ELEMENT Tag="RobotCommand/Grip/Vacuum/@Suction" Type="INT"/>
         <ELEMENT Tag="RobotCommand/Grip/Vacuum/@Cylinder" Type="REAL"/>
         <!-- Custom command -->
         <ELEMENT Tag="RobotCommand/CustomCmd/@CmdIndex" Type="INT"/>
      </XML>
   </RECEIVE>
   
   <SEND>
      <XML>
          <!-- Program State -->
         <ELEMENT Tag="ProgramState/State/@Status"/>
         <ELEMENT Tag="ProgramState/State/@Stopped"/>
         <!-- Command Result -->
         <ELEMENT Tag="ProgramState/Command/@Id"/>
         <ELEMENT Tag="ProgramState/Command/State/@Status"/>
         <!-- Error -->
         <ELEMENT Tag="ProgramState/Command/Error/@Code"/>
         <ELEMENT Tag="ProgramState/Command/Error/@Message"/>
      </XML>
   </SEND>
</ETHERNETKRL>