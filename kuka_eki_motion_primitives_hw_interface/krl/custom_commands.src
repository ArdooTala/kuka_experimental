&ACCESS RVE
def custom_commands()
end

global deffct int do_custom_command (custom_cmd_data :in, cmd_id :in)
   decl custom_cmd_type custom_cmd_data
   decl int cmd_id
   decl int error_code
   
   error_code=0
   
   switch (custom_cmd_data.index)
      case 1
         home_all()
      case 2
         MsgNotify("Custom Command Executed")
      case 3
         custom_command_1()
      default
         error_code = 2
   endswitch
   
   return error_code
endfct

def home_all()
   ptp {A1 0.0, A2 90.0, A3 -90.0, A4 0.0, A5 0.0, A6 0.0, E1 0.0, E2 0.0, E3 0.0, E4 0.0, E5 0.0, E6 0.0}
end

def custom_command_1()
   $OUT[51]=TRUE
   WAIT SEC 1
   $OUT[51]=FALSE
end
