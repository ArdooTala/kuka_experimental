deffct int do_custom_command(custom_cmd_data :in, cmd_id :in)
  decl int cmd_id
  decl custom_cmd_type custom_cmd_data

  decl int error_code = 0

  switch (custom_cmd_data.index)
    case 1
      home_all()
    case 2
      show_MsgNotify()
    case 3
      custom_command_1()
    case 4
      custom_cmd_w_param()
    default
      error_code = 2

  return error_code
end

def home_all()
  ptp $XHOME
end

def custom_command_1()
  $OUT[51]=TRUE
  WAIT SEC 1
  $OUT[51]=FALSE
end

def show_MsgNotify()
  decl char msg_text[128]
  decl int i

  for i = 1 to 128
    msg_text[i] = STR_PARAM[1, i]
  endfor
  MsgNotify("Input Param: %1", "EKICustomCommand", , msg_text[], )
end

def custom_cmd_w_param()
  decl char msg[26]
  decl int i

  for i = 1 to 26
    msg[i] = STR_PARAM[1, i]
  endfor

  MsgNotifyTextPar("[NUM]: %2 - [MSG]: %1", "EKICustomCommand", INT_PARAM[1], msg[], , 1111)
end

